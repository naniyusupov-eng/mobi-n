{
  "expo": {
    "name": "RCandy",
    "slug": "rcandy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "uz.rcandy.agent",
      "adaptiveIcon": {
        "backgroundColor": "#0B6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Savdo agenti QR kodini skanerlash uchun kameraga ruxsat bering.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Do'konlarga tashrif buyurilganini va lokatsiyasini aniqlash uchun ruxsat bering."
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.google.mlkit.** { *; }\n-keep class expo.modules.camera.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50b2108f-4853-4ec8-86d5-7fe91dbf8ee7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/50b2108f-4853-4ec8-86d5-7fe91dbf8ee7"
    }
  }
}
